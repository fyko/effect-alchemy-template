{
  "name": "effect-alchemy-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "vp check && pnpm test",
    "prepare": "effect-tsgo patch --oxlint",
    "ready": "vp run check",
    "test": "vp run -r test",
    "dev": "vp run @template/api#dev",
    "plan:production": "vp run @template/api#plan:production",
    "deploy:production": "vp run @template/api#deploy:production",
    "destroy:production": "vp run @template/api#destroy:production"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@effect/tsgo": "0.53.4",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "26.6.5",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.5",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
